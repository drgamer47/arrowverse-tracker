{
  "manifest_version": 3,
  "name": "Arrowverse Watch Tracker",
  "version": "2.0.0",
  "description": "Track Arrowverse chronological watch order on Netflix, Prime Video, and Pluto TV.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.com/*",
    "https://pluto.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://pluto.tv/*"
      ],
      "js": ["arrowverse-data.js", "arrowverse-analytics.js", "arrowverse-store.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle Arrowverse watch-order overlay"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
